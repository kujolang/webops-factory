{
  "name": "@kujolang/webops-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.1 <27"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "login": "node scripts/login.mjs",
    "doctor": "python3 src/factory.py doctor",
    "factory": "python3 src/factory.py",
    "start": "python3 src/factory.py serve",
    "test": "python3 -m unittest discover -s tests -v",
    "verify": "npm test && python3 scripts/check_docs.py",
    "demo": "python3 src/factory.py import-example",
    "verify:floor": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@kujolang/kujo-runtime": "1.9.0",
    "@openai/codex": "0.144.4",
    "playwright": "1.61.1"
  },
  "description": "Inspect a static website, prepare bounded repairs and verify the result before human review"
}
